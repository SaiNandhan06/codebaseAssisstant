# =====================================================================
# Codebase Assistant Environment Configuration
# Copy this file to .env and configure your values.
# =====================================================================

# Google Gemini API Key (Required)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Generation Model (Default: gemini-2.5-flash)
GEN_MODEL=gemini-2.5-flash

# Dense Embedding Model (Default: gemini-embedding-001, 3072 dimensions)
EMBED_MODEL=gemini-embedding-001

# Cross-Encoder Re-ranker Model (HuggingFace sentence-transformers)
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2

# Hallucination Shield Threshold (Logit gating)
# Chunks scoring below this logit are discarded; if all are below, low_confidence triggers.
# Recommended: -7.5 for conceptual documentation + precise code queries.
RERANK_THRESHOLD=-7.5

# Qdrant Vector Database Configuration
# Mode: "auto" (detect server, fallback to local), "local", or "server"
QDRANT_MODE=auto
QDRANT_HOST=localhost
QDRANT_PORT=6333

